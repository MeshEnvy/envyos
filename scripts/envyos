#!/usr/bin/env bash
# EnvyOS distro CLI — build, bump, publish, info.
set -euo pipefail

_resolve_script_dir() {
  local source="${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}"
  local dir
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SCRIPTS="$ROOT/scripts"
# shellcheck source=scripts/version.sh
source "$SCRIPTS/version.sh"

usage() {
  cat >&2 <<EOF
usage: envyos <command> [args…]

commands:
  info                              Dev HEAD, package versions, artifact status
  build [pkg…] [options…]           Build packages (default: all pinned)
  bump-ev <pkg>                     Bump packages-meta ev counter (meshcore|adafruit-nrf52-bootloader|motatool)
  fetch <pkg>                       Ensure packages/<pkg> checkout exists
  bump patch|minor|major <package>  Bump package pin (legacy)
  semver suggest                    Proposed distro tag from CHANGELOG + bundle policy
  publish [options] [vX.Y.Z]        Promote branch bench → version tree, lock, upload
  publish release [vX.Y.Z]          Refresh build/<ver>/release from bench
  publish finalize [vX.Y.Z]         Lock release + git tag (requires stage)
  publish upload vX.Y.Z             GitHub Release from staged files
  restore firmware [vX.Y.Z]…        Hydrate released firmware trees from GitHub
  restore bootloader [vX.Y.Z]…      Hydrate released EnvyBoot trees from GitHub
  restore [vX.Y.Z]…                 Restore firmware + bootloader (default)
  gucp check [vX.Y.Z]               Verify GUCP registry for a release
  gucp list                         List release sections and blocking rows
  gucp audit [vX.Y.Z] [N]           Triage: candidates + last N meshcore commits
  changelog check [vX.Y.Z]          Verify Packages table + package changelogs
  changelog delta [vX.Y.Z]          Print package version deltas for a release

  build packages: meshcore (firmware) | adafruit-nrf52-bootloader (bootloader, bl) | motatool | peaky | envybot | mcmt-gateway | all
  Omit package list for full bench build (motatool → bootloader → meshcore order).

examples:
  envyos build
  envyos build motatool meshcore
  envyos build meshcore --target wismesh-tag-repeater
  envyos bump-ev meshcore
  envyos fetch meshcore
  envyos publish --dry-run
EOF
  exit 2
}

cmd_info() {
  local id ver status last_distro slot proposed
  slot="$(read_build_slot)"
  echo "Build slot: $slot  →  build/$slot/"
  echo ""
  echo "Next release (MANIFEST.json releases.next)"
  list_manifest | sed 's/^/  /'
  proposed="$(propose_next_distro_version 2>/dev/null || echo '?')"
  level="$(suggest_distro_bump_level 2>/dev/null || echo '?')"
  echo "  (publish suggests: $level → $proposed)"
  echo ""
  echo "Package checkouts (packages/)"
  printf '  meshcore    %s\n' "$(submodule_git_sha meshcore)"
  printf '  adafruit-nrf52-bootloader  %s\n' "$(submodule_git_sha adafruit-nrf52-bootloader)"
  printf '  motatool    %s\n' "$(submodule_git_sha motatool)"
  printf '  meshcore-open %s\n' "$(submodule_git_sha meshcore-open)"
  printf '  mcmt-gateway %s\n' "$(submodule_git_sha mcmt-gateway)"
  echo ""
  echo "Package meta (packages-meta/)"
  for pkg in meshcore adafruit-nrf52-bootloader motatool; do
    printf '  %-28s %s\n' "$pkg" "$(read_package_version "$pkg" 2>/dev/null || echo '?')"
  done
  if ver="$(read_optional_manifest_key envybot 2>/dev/null)"; then
    printf '  %-12s %s\n' envybot "$ver"
  fi
  if ver="$(read_optional_manifest_key mcmt-gateway 2>/dev/null)"; then
    printf '  %-12s %s\n' mcmt-gateway "$ver"
  fi
  if ver="$(read_optional_manifest_key peaky 2>/dev/null)"; then
    printf '  %-12s %s\n' peaky "$ver"
  fi
  echo ""
  last_distro="$(latest_published_distro_tag 2>/dev/null || true)"
  if [[ -n "$last_distro" ]]; then
    echo "Last published distro: $last_distro"
    for id in distro meshcore adafruit-nrf52-bootloader motatool; do
      ver="$(manifest_package_version "$id" "$last_distro" 2>/dev/null || echo '?')"
      [[ "$id" == meshcore && "$ver" == "?" ]] && ver="$(manifest_package_version firmware "$last_distro" 2>/dev/null || echo '?')"
      printf '  %-28s %s\n' "$id" "$ver"
    done
    published="$(read_release_manifest_key "$last_distro" published 2>/dev/null || echo '?')"
    printf '  published    %s\n' "$published"
    echo ""
  else
    echo "Last published distro: (none)"
    echo ""
  fi
  echo "Artifacts"
  for key in meshcore adafruit-nrf52-bootloader motatool; do
    ver="$(read_manifest_key "$key")"
    id="$(package_to_bench_id "$key")"
    status="$(package_artifact_status "$id" "$ver")"
    if [[ "$key" == motatool ]]; then
      platforms="$(list_staged_motatool_platforms "$ver" | paste -sd, -)"
      printf '  %-28s %-12s  %s  (%s%s)
' "$key" "$ver" "$(package_build_dir "$id" "$ver")" "$status" \
        "${platforms:+, $platforms}"
    else
      printf '  %-28s %-12s  %s  (%s)
' "$key" "$ver" "$(package_build_dir "$id" "$ver")" "$status"
    fi
  done
  if ver="$(read_optional_manifest_key envybot 2>/dev/null)"; then
    status="$(package_artifact_status envybot "$ver")"
    printf '  %-12s %-8s  %s  (%s)
' envybot "$ver" "$(package_build_dir envybot "$ver")" "$status"
  fi
  if ver="$(read_optional_manifest_key mcmt-gateway 2>/dev/null)"; then
    status="$(package_artifact_status mcmt-gateway "$ver")"
    printf '  %-12s %-8s  %s  (%s)
' mcmt-gateway "$ver" "$(package_build_dir mcmt-gateway "$ver")" "$status"
  fi
  if ver="$(read_optional_manifest_key peaky 2>/dev/null)"; then
    status="$(package_artifact_status peaky "$ver")"
    printf '  %-12s %-8s  %s  (%s)
' peaky "$ver" "$(package_build_dir peaky "$ver")" "$status"
  fi
}

cmd_semver() {
  case "${1:-suggest}" in
    suggest)
      print_distro_publish_recommendation
      ;;
    *)
      echo "usage: envyos semver suggest" >&2
      exit 2
      ;;
  esac
}

cmd_build() {
  local packages=() pkg
  while [[ $# -gt 0 ]]; do
    case "$1" in
      meshcore | firmware | f)
        packages+=(meshcore)
        shift
        ;;
      bootloader | bl | adafruit-nrf52-bootloader)
        packages+=(adafruit-nrf52-bootloader)
        shift
        ;;
      motatool | mt)
        packages+=(motatool)
        shift
        ;;
      peaky | pk)
        packages+=(peaky)
        shift
        ;;
      envybot | eb)
        packages+=(envybot)
        shift
        ;;
      mcmt-gateway | mcmt)
        packages+=(mcmt-gateway)
        shift
        ;;
      all | "")
        shift
        exec "$SCRIPTS/build-all.sh" "$@"
        ;;
      release | stage)
        shift
        populate_distro_release "$@"
        return 0
        ;;
      -h | --help | help)
        exec "$SCRIPTS/build-all.sh" --help
        ;;
      --*)
        break
        ;;
      *)
        if is_build_version_arg "$1"; then
          die_build_version_arg "$1"
        fi
        packages+=("$1")
        shift
        ;;
    esac
  done

  if ((${#packages[@]} == 0)); then
    exec "$SCRIPTS/build-all.sh" "$@"
  fi

  local recipe
  for pkg in "${packages[@]}"; do
    case "$pkg" in
      firmware) pkg=meshcore ;;
    esac
    recipe="$ROOT/packages-meta/$pkg/build.sh"
    [[ -x "$recipe" ]] || {
      echo "error: unknown package '$pkg' (no packages-meta/$pkg/build.sh)" >&2
      exit 1
    }
    "$recipe" "$@"
  done
}

cmd_bump_ev() {
  local pkg="${1:-}"
  [[ -n "$pkg" ]] || {
    echo "usage: envyos bump-ev meshcore|adafruit-nrf52-bootloader|bootloader|motatool" >&2
    exit 2
  }
  case "$pkg" in
    firmware) pkg=meshcore ;;
    bootloader | bl) pkg=adafruit-nrf52-bootloader ;;
  esac
  local new_ver
  new_ver="$(bump_package_ev "$pkg")"
  echo "$pkg: ev bumped → $new_ver"
}

cmd_fetch() {
  local pkg="${1:-}"
  [[ -n "$pkg" ]] || {
    echo "usage: envyos fetch meshcore|adafruit-nrf52-bootloader|bootloader|motatool|mcmt-gateway|meshcore-open|envybot|peaky" >&2
    exit 2
  }
  fetch_package_checkout "$pkg"
}

cmd_bump() {
  local level="${1:-}" id="${2:-}"
  local old new
  [[ -n "$level" && -n "$id" ]] || {
    echo "usage: envyos bump patch|minor|major meshcore|firmware|adafruit-nrf52-bootloader|bootloader|motatool" >&2
    exit 2
  }
  case "$level" in
    patch | minor | major) ;;
    *)
      echo "error: bump level must be patch, minor, or major (got '$level')" >&2
      exit 1
      ;;
  esac
  read -r old new < <(bump_package "$id" "$level")
  echo "$id: $old → $new"
}

cmd_restore() {
  local target="all"
  if [[ $# -ge 1 ]]; then
    case "$1" in
      firmware | fw | bootloader | bl | all)
        target="$1"
        shift
        ;;
    esac
  fi

  case "$target" in
    firmware | fw)
      exec "$SCRIPTS/restore-firmware.sh" "$@"
      ;;
    bootloader | bl)
      exec "$SCRIPTS/restore-bootloader.sh" "$@"
      ;;
    all)
      "$SCRIPTS/restore-firmware.sh" "$@"
      "$SCRIPTS/restore-bootloader.sh" "$@"
      ;;
    *)
      echo "error: unknown restore target '$target' (want firmware, bootloader, or all)" >&2
      exit 1
      ;;
  esac
}

cmd_publish() {
  case "${1:-}" in
    release | stage)
      shift
      populate_distro_release "$@"
      exit 0
      ;;
    finalize)
      shift
      exec "$SCRIPTS/publish.sh" --finalize "$@"
      ;;
    upload)
      shift
      exec "$SCRIPTS/publish.sh" --upload "$@"
      ;;
  esac
  exec "$SCRIPTS/publish.sh" "$@"
}

[[ $# -ge 1 ]] || usage

case "$1" in
  info)
    cmd_info
    ;;
  build)
    shift
    cmd_build "$@"
    ;;
  bump-ev)
    shift
    cmd_bump_ev "$@"
    ;;
  fetch)
    shift
    cmd_fetch "$@"
    ;;
  bump)
    shift
    cmd_bump "$@"
    ;;
  publish)
    shift
    cmd_publish "$@"
    ;;
  restore)
    shift
    cmd_restore "$@"
    ;;
  gucp)
    shift
    exec "$SCRIPTS/gucp.sh" "$@"
    ;;
  changelog)
    shift
    exec "$SCRIPTS/changelog.sh" "$@"
    ;;
  semver)
    shift
    cmd_semver "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    echo "error: unknown command '$1'" >&2
    usage
    ;;
esac
